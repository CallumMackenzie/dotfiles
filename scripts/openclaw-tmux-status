#!/bin/sh

# Print one tab-separated aggregate-status/session/pane-statuses/active row for
# every local tmux session. When given a terminal TTY, mark the session attached
# to that tmux client active. Ignore stale aliases and missing panes, reduce
# aliases to the newest status per pane, overlay unread completions from
# tmux-notify-jump, then aggregate with priority
# progressing > unread > finished > stopped.

set -eu

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/openclaw-tmux"
client_tty="${1:-}"

if command -v tmux >/dev/null 2>&1; then
    tmux_bin="$(command -v tmux)"
elif [ -x "$HOME/.nix-profile/bin/tmux" ]; then
    tmux_bin="$HOME/.nix-profile/bin/tmux"
elif [ -x /opt/homebrew/bin/tmux ]; then
    tmux_bin=/opt/homebrew/bin/tmux
else
    exit 1
fi

registry=""
if command -v jq >/dev/null 2>&1 && [ -d "$state_dir" ]; then
    set -- "$state_dir"/*.json
    if [ -e "$1" ]; then
        registry="$(
            jq -rs '
                .[]
                | select(
                    (.tmuxSessionId | type) == "string" and
                    (.pane | type) == "string" and
                    (.updatedAt | type) == "number" and
                    (.status == "progressing" or .status == "finished" or .status == "stopped")
                )
                | [.tmuxSessionId, .pane, .status, .updatedAt]
                | @tsv
            ' "$@" 2>/dev/null | tr '\n' '|' || true
        )"
    fi
fi

live_panes="$($tmux_bin list-panes -a -F '#{session_id}\t#{pane_id}' 2>/dev/null | tr '\n' '|' || true)"

active_session_id=""
case "$client_tty" in
    /dev/*)
        active_session_id="$(
            $tmux_bin list-clients -F '#{client_tty}:#{session_id}' 2>/dev/null |
                awk -F ':' -v tty="$client_tty" '$1 == tty { print $2; exit }'
        )"
        ;;
esac

unread_panes=""
inbox_root="$($tmux_bin show-option -gqv @tmux-notify-jump-inbox-root 2>/dev/null || true)"
case "$inbox_root" in
    /*/tmux-notify-jump/inbox/*)
        if [ -d "$inbox_root" ] && [ ! -L "$inbox_root" ]; then
            for entry in "$inbox_root"/*; do
                [ -d "$entry" ] && [ ! -L "$entry" ] && [ -f "$entry/kind" ] || continue
                pane=""
                IFS= read -r pane <"$entry/pane_id" 2>/dev/null || true
                case "$pane" in
                    %*) unread_panes="${unread_panes}${pane}|" ;;
                esac
            done
        fi
        ;;
esac

"$tmux_bin" list-sessions -F '#{session_id}:#{session_name}' 2>/dev/null |
    awk -F ':' -v registry="$registry" -v live_panes="$live_panes" -v unread_panes="$unread_panes" -v active_session_id="$active_session_id" '
        BEGIN {
            live_count = split(live_panes, live_lines, "|")
            for (i = 1; i <= live_count; i++) {
                split(live_lines[i], fields, "\t")
                if (fields[1] != "" && fields[2] != "") {
                    live[fields[1] SUBSEP fields[2]] = 1
                }
            }

            unread_count = split(unread_panes, unread_lines, "|")
            for (i = 1; i <= unread_count; i++) {
                if (unread_lines[i] != "") unread[unread_lines[i]] = 1
            }

            count = split(registry, lines, "|")
            for (i = 1; i <= count; i++) {
                split(lines[i], fields, "\t")
                session = fields[1]
                pane = fields[2]
                state = fields[3]
                updated = fields[4] + 0
                key = session SUBSEP pane
                if (live[key] && (latest[key] == "" || updated >= latest[key])) {
                    latest[key] = updated
                    pane_state[key] = state
                }
            }

            # Preserve tmux pane order in the icon list. Iterating pane_state
            # directly would make the display order depend on awk internals.
            for (i = 1; i <= live_count; i++) {
                split(live_lines[i], fields, "\t")
                session = fields[1]
                pane = fields[2]
                key = session SUBSEP pane
                if (!(key in pane_state)) continue
                state = pane_state[key]
                icon_state = state
                if (state == "finished" && unread[pane]) icon_state = "unread"
                if (pane_states[session] != "") pane_states[session] = pane_states[session] ","
                pane_states[session] = pane_states[session] icon_state
                if (state == "progressing") states[session] = "progressing"
                else if (icon_state == "unread" && states[session] != "progressing") states[session] = "unread"
                else if (state == "finished" && states[session] != "progressing" && states[session] != "unread") states[session] = "finished"
                else if (states[session] == "") states[session] = "stopped"
            }
        }
        {
            state = states[$1]
            if (state == "") state = "stopped"
            icons = pane_states[$1]
            if (icons == "") icons = "stopped"
            active = ($1 == active_session_id ? "active" : "inactive")
            print state "\t" $2 "\t" icons "\t" active
        }
    '
