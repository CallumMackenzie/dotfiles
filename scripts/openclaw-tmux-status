#!/bin/sh

# Print one tab-separated status/session pair for every local tmux session.
# Aggregate priority is progressing > finished > stopped.

set -eu

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/openclaw-tmux"

if command -v tmux >/dev/null 2>&1; then
    tmux_bin="$(command -v tmux)"
elif [ -x "$HOME/.nix-profile/bin/tmux" ]; then
    tmux_bin="$HOME/.nix-profile/bin/tmux"
elif [ -x /opt/homebrew/bin/tmux ]; then
    tmux_bin=/opt/homebrew/bin/tmux
else
    exit 1
fi

registry=""
if command -v jq >/dev/null 2>&1 && [ -d "$state_dir" ]; then
    set -- "$state_dir"/*.json
    if [ -e "$1" ]; then
        registry="$(
            jq -rs '
                map(select(
                    (.tmuxSessionId | type) == "string" and
                    (.status == "progressing" or .status == "finished" or .status == "stopped")
                ))
                | group_by(.tmuxSessionId)
                | .[]
                | [
                    .[0].tmuxSessionId,
                    (if any(.[]; .status == "progressing") then "progressing"
                     elif any(.[]; .status == "finished") then "finished"
                     else "stopped"
                     end)
                  ]
                | @tsv
            ' "$@" 2>/dev/null | tr '\n' '|' || true
        )"
    fi
fi

"$tmux_bin" list-sessions -F '#{session_id}:#{session_name}' 2>/dev/null |
    awk -F ':' -v registry="$registry" '
        BEGIN {
            count = split(registry, lines, "|")
            for (i = 1; i <= count; i++) {
                split(lines[i], fields, "\t")
                if (fields[1] != "" && fields[2] != "") {
                    states[fields[1]] = fields[2]
                }
            }
        }
        {
            state = states[$1]
            if (state == "") state = "stopped"
            print state "\t" $2
        }
    '
